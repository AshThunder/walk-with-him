# Godot 4+ import cache and editor state (do not commit)
.godot/

# Android Gradle export workspace (Godot regenerates this)
/android/

# Translations generated by the editor
*.translation

# Builds and packages
build/
*.apk
*.aab
*.ipa
*.so

# Signing and secrets — never commit these
*.keystore
*.jks
key.properties
.env
.env.*
export_credentials.cfg

# Local asset downloads and scratch (Kenney zips, unused kits)
_dl/

# OS / editor junk
.DS_Store
Thumbs.db
*~
*.tmp
shots/*.tmp
